<Window x:Class="CalendarReminder.App.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="导出日历" Icon="Assets/AppIcon.ico" Width="640" Height="570" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F7FB">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="导出日历" FontSize="26" FontWeight="SemiBold"/>
 <StackPanel Grid.Row="1" Margin="0,25,0,0"><TextBlock Text="开始时间"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><DatePicker x:Name="StartDate" Width="190" Padding="8"/><ComboBox x:Name="StartHour" Width="90" Margin="14,0,0,0"/><TextBlock Text="时" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="StartMinute" Width="90"/><TextBlock Text="分" VerticalAlignment="Center" Margin="8,0"/></StackPanel></StackPanel>
 <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="结束时间"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><DatePicker x:Name="EndDate" Width="190" Padding="8"/><ComboBox x:Name="EndHour" Width="90" Margin="14,0,0,0"/><TextBlock Text="时" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="EndMinute" Width="90"/><TextBlock Text="分" VerticalAlignment="Center" Margin="8,0"/></StackPanel></StackPanel>
 <StackPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock Text="导出格式"/><ComboBox x:Name="FormatInput" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left"/></StackPanel>
 <Border Grid.Row="4" x:Name="ResultPanel" Background="#E8F6ED" CornerRadius="8" Padding="16" Margin="0,22,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="#176B37"/><Button Content="打开所在文件夹" Background="#CFEBD8" Foreground="#176B37" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OpenFolder_Click"/></StackPanel></Border>
 <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="取消" Background="#E9ECF3" Margin="0,0,12,0" Click="Cancel_Click"/><Button x:Name="ExportButton" Content="选择位置并导出" Background="{StaticResource Primary}" Foreground="White" Click="Export_Click"/></StackPanel></Grid>
</Window>
