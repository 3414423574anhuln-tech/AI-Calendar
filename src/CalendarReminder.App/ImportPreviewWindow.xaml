<Window x:Class="CalendarReminder.App.ImportPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="导入预览" Icon="Assets/AppIcon.ico" Width="1050" Height="680" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="导入预览" FontSize="26" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="请检查、修改或删除识别结果。无效记录不会保存，确认前数据库不会变化。" Foreground="#687086" Margin="0,8,0,18"/>
 <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="导入" Binding="{Binding IsSelected}" Width="60"/><DataGridTemplateColumn Header="日期" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Date, StringFormat=yyyy/MM/dd}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTextColumn Header="小时" Binding="{Binding Hour, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="分钟" Binding="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="提醒时间" Binding="{Binding DisplayReminderTime}" IsReadOnly="True" Width="145"/><DataGridTextColumn Header="安排" Binding="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="识别状态" Binding="{Binding Status}" IsReadOnly="True" Width="100"/><DataGridCheckBoxColumn Header="重复" Binding="{Binding IsDuplicate}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="说明" Binding="{Binding ErrorReason}" IsReadOnly="True" Width="220"/></DataGrid.Columns></DataGrid>
 <Grid Grid.Row="3" Margin="0,20,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="重复项处理：" VerticalAlignment="Center"/><ComboBox x:Name="DuplicateActionInput" Width="170"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="删除选中行" Background="#FFE9E9" Foreground="#B52222" Margin="0,0,12,0" Click="DeleteRow_Click"/><Button Content="取消" Background="#E9ECF3" Margin="0,0,12,0" Click="Cancel_Click"/><Button x:Name="ImportButton" Content="确认导入" Background="{StaticResource Primary}" Foreground="White" Click="Import_Click"/></StackPanel></Grid></Grid>
</Window>
