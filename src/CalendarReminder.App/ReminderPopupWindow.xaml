<Window x:Class="CalendarReminder.App.ReminderPopupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="日程提醒" Icon="Assets/AppIcon.ico" Width="500" SizeToContent="Height" MaxHeight="620" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" Background="#F7F8FC">
 <Border BorderBrush="#6A5AF9" BorderThickness="1" CornerRadius="14" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Background="#6A5AF9" CornerRadius="18" Width="36" Height="36"><TextBlock Text="!" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="日程提醒" FontSize="24" FontWeight="SemiBold" Foreground="#20263A" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
 <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="ReminderTimeText" Foreground="#5A4FCF" FontWeight="SemiBold"/><TextBlock x:Name="ScheduleTimeText" Foreground="#687086" Margin="0,6,0,0"/></StackPanel>
 <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="16" Margin="0,18,0,0"><ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ContentText" TextWrapping="Wrap" FontSize="16" Foreground="#272C3B"/></ScrollViewer></Border>
 <Button Grid.Row="3" Content="我知道了" Background="#6A5AF9" Foreground="White" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" Click="Close_Click"/></Grid></Border>
</Window>
