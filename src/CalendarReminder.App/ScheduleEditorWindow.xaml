<Window x:Class="CalendarReminder.App.ScheduleEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="日程" Icon="Assets/AppIcon.ico" Width="600" Height="690" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Heading" Text="新建日程" FontSize="26" FontWeight="SemiBold" Foreground="#20263A"/>
 <StackPanel Grid.Row="1" Margin="0,24,0,0"><TextBlock Text="日程日期" Margin="0,0,0,7"/><DatePicker x:Name="DateInput" Padding="8"/></StackPanel>
 <StackPanel Grid.Row="2" Margin="0,15,0,0"><TextBlock Text="日程时间" Margin="0,0,0,7"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="HourInput" Width="110"/><TextBlock Text="时" VerticalAlignment="Center" Margin="10,0,22,0"/><ComboBox x:Name="MinuteInput" Width="110"/><TextBlock Text="分" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></StackPanel>
 <Border Grid.Row="3" Background="#F0EDFF" CornerRadius="10" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock Text="提醒日期及时间" FontSize="16" FontWeight="SemiBold" Foreground="#493DA5"/><TextBlock Text="到达此时间后，即使主窗口已关闭到后台，也会显示提醒弹窗。" Foreground="#6F679C" FontSize="12" Margin="0,5,0,12"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="ReminderDateInput" Width="190" Padding="8"/><ComboBox x:Name="ReminderHourInput" Width="90" Margin="14,0,0,0"/><TextBlock Text="时" VerticalAlignment="Center" Margin="8,0"/><ComboBox x:Name="ReminderMinuteInput" Width="90"/><TextBlock Text="分" VerticalAlignment="Center" Margin="8,0"/></StackPanel></StackPanel></Border>
 <TextBlock Grid.Row="4" Text="安排内容" Margin="0,18,0,7"/>
 <TextBox Grid.Row="5" x:Name="ContentInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="125"/>
 <Grid Grid.Row="6" Margin="0,22,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="DeleteButton" Content="删除" Background="#FFE9E9" Foreground="#B52222" Visibility="Collapsed" Click="Delete_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Background="#E9ECF3" Margin="0,0,12,0" Click="Cancel_Click"/><Button Content="确定" Background="{StaticResource Primary}" Foreground="White" Click="Confirm_Click"/></StackPanel></Grid></Grid>
</Window>
